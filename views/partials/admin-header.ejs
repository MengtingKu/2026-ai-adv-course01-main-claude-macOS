<header class="admin-bar sticky top-0 z-50">
  <div class="flex items-center justify-between px-6 h-14">
    <span class="font-bold text-sm tracking-wide" style="font-family: 'Noto Serif TC', serif; color: var(--color-ivory);">花漾生活</span>
    <div id="admin-auth-nav" class="flex items-center gap-4" style="font-size: 0.8125rem; color: var(--color-ivory-muted);">
      <a href="/" style="color: inherit;" onmouseover="this.style.color='var(--color-ivory)'" onmouseout="this.style.color='var(--color-ivory-muted)'">返回前台</a>
      <span style="color: rgba(201,169,110,0.25);">|</span>
      <span id="admin-username"></span>
      <button type="button" onclick="Auth.logout()" style="color: inherit; background: none; border: none; cursor: pointer; padding: 0;" onmouseover="this.style.color='var(--color-ivory)'" onmouseout="this.style.color='var(--color-ivory-muted)'">登出</button>
    </div>
  </div>
</header>
