<div id="app" v-cloak>
  <div class="flex items-center justify-between mb-6">
    <div>
      <h1 class="text-2xl font-bold admin-title">商品管理</h1>
      <p class="text-sm mt-1 admin-subtitle">Manage your botanical inventory and product listings.</p>
    </div>
    <button type="button" @click="openCreate" class="admin-btn-gold">
      <span class="material-symbols-outlined" style="font-size: 18px; font-variation-settings: 'FILL' 0, 'wght' 300, 'GRAD' 0, 'opsz' 20;">add</span>
      新增商品
    </button>
  </div>

  <div v-if="loading" class="flex justify-center py-12">
    <div class="w-8 h-8 border-4 border-t-transparent rounded-full animate-spin" style="border-color: var(--color-gold); border-top-color: transparent;"></div>
  </div>

  <template v-else>
    <table class="admin-table-card w-full text-sm">
      <thead>
        <tr>
          <th class="text-left">圖片</th>
          <th class="text-left">商品名稱</th>
          <th class="text-right">價格</th>
          <th class="text-right">庫存</th>
          <th class="text-right">操作</th>
        </tr>
      </thead>
      <tbody>
        <tr v-for="product in products" :key="product.id">
          <td style="width: 72px;">
            <img
              :src="product.image_url || 'https://images.unsplash.com/photo-1490750967868-88aa4f44baee?w=100'"
              :alt="product.name"
              class="w-12 h-12 rounded-lg object-cover"
            />
          </td>
          <td><span class="admin-cell-name">{{ product.name }}</span></td>
          <td class="text-right"><span class="admin-cell-price">NT${{ product.price.toLocaleString() }}</span></td>
          <td class="text-right"><span class="admin-cell-muted">{{ product.stock }}</span></td>
          <td class="text-right" style="white-space: nowrap;">
            <button type="button" @click.stop="openEdit(product)" class="admin-action-edit">編輯</button>
            <button type="button" @click.stop="confirmDeleteFn(product.id)" class="admin-action-delete">刪除</button>
          </td>
        </tr>
      </tbody>
    </table>

    <div v-if="pagination.total > 0" class="flex items-center justify-between mt-5">
      <span class="admin-count-text">
        Showing {{ (pagination.page - 1) * pagination.limit + 1 }} to {{ Math.min(pagination.page * pagination.limit, pagination.total) }} of {{ pagination.total }} entries
      </span>
      <div class="flex items-center gap-2">
        <button type="button" @click="loadProducts(pagination.page - 1)" :disabled="pagination.page <= 1" class="admin-prev-next">Previous</button>
        <button type="button" @click="loadProducts(pagination.page + 1)" :disabled="pagination.page >= pagination.totalPages" class="admin-prev-next">Next</button>
      </div>
    </div>
  </template>

  <div v-if="modalVisible" id="product-modal" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40" @click="modalVisible = false"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-lg mx-4 p-6" style="color: #374151;">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-lg font-semibold" style="color: #111827;">{{ editingProduct ? '編輯商品' : '新增商品' }}</h3>
        <button type="button" @click="modalVisible = false" class="text-gray-400 hover:text-gray-700 text-xl leading-none">&times;</button>
      </div>
      <form @submit.prevent="handleSave" class="space-y-4">
        <div>
          <label class="block text-sm mb-1" style="color: #6b7280;">商品名稱 *</label>
          <input v-model="form.name" type="text" data-autofocus style="color: #111827;" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-rose-primary" />
        </div>
        <div>
          <label class="block text-sm mb-1" style="color: #6b7280;">商品描述</label>
          <textarea v-model="form.description" rows="3" style="color: #111827;" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-rose-primary"></textarea>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm mb-1" style="color: #6b7280;">價格 *</label>
            <input v-model.number="form.price" type="number" min="1" style="color: #111827;" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-rose-primary" />
          </div>
          <div>
            <label class="block text-sm mb-1" style="color: #6b7280;">庫存 *</label>
            <input v-model.number="form.stock" type="number" min="0" style="color: #111827;" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-rose-primary" />
          </div>
        </div>
        <div>
          <label class="block text-sm mb-1" style="color: #6b7280;">圖片 URL</label>
          <input v-model="form.image_url" type="text" style="color: #111827;" class="w-full border border-gray-200 rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-rose-primary" />
        </div>
        <div class="flex justify-end gap-3 pt-2">
          <button type="button" @click="modalVisible = false" class="px-4 py-2 text-sm rounded-lg border border-gray-200 hover:bg-gray-50" style="color: #6b7280;">取消</button>
          <button type="submit" :disabled="saving" class="px-4 py-2 text-sm rounded-lg font-medium disabled:opacity-50" style="background: var(--color-gold); color: var(--color-forest);">
            {{ saving ? '儲存中...' : '儲存' }}
          </button>
        </div>
      </form>
    </div>
  </div>

  <div v-if="confirmVisible" id="confirm-dialog" class="fixed inset-0 z-50 flex items-center justify-center">
    <div class="absolute inset-0 bg-black/40" @click="confirmVisible = false"></div>
    <div class="relative bg-white rounded-2xl shadow-xl w-full max-w-sm mx-4 p-6 text-center">
      <h3 class="text-lg font-semibold mb-2" style="color: #111827;">確認刪除</h3>
      <p class="text-sm mb-6" style="color: #6b7280;">確定要刪除這個商品嗎？此操作無法復原。</p>
      <div class="flex gap-3 justify-center">
        <button type="button" data-autofocus @click="confirmVisible = false" class="px-4 py-2 text-sm rounded-lg border border-gray-200 hover:bg-gray-50" style="color: #6b7280;">取消</button>
        <button type="button" @click="handleDelete" class="px-4 py-2 text-sm rounded-lg bg-red-500 text-white hover:bg-red-600">確認刪除</button>
      </div>
    </div>
  </div>
</div>
